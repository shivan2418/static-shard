{
  "name": "static-shard-cli",
  "version": "0.0.0",
  "description": "Build tool for static-shard: infer → shard → index → codegen + config wizard.",
  "type": "module",
  "license": "MIT",
  "author": "Emil Elgaard",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "static-shard": "./dist/bin.js"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivan2418/static-shard.git",
    "directory": "packages/static-shard-cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run --json"
  }
}
